{
  "openapi": "3.0.0",
  "info": {
    "title": "WhetData API",
    "description": "Text processing and validation for product descriptions and content optimization.",
    "version": "1.0.0",
    "contact": {
      "name": "WhetData Support",
      "email": "hagi@whetdata.com"
    }
  },
  "servers": [
    {
      "url": "https://whetdata.com/api/ult",
      "description": "Whetdata API endpoint"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/": {
      "post": {
        "summary": "[DISABLED] Ultimate Text Processing",
        "description": "[DISABLED] Classify, nudge, or clean text content",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action", "text"],
                "properties": {
                  "action": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["classification", "nudges", "clean"]
                    },
                    "description": "Action type: classification | nudges | clean"
                  },
                  "ruleset": {
                    "type": "string",
                    "description": "Ruleset name (required for nudges)",
                    "enum": ["product", "product_description", "marketing_copy", "product_review", "technical_documentation", "date_online"]
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 5000,
                    "description": "Input text (max 5,000 characters)"
                  },
                  "max_nudges": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Maximum number of nudges to generate (required for nudges action)"
                  }
                }
              },
              "examples": {
                "classification": {
                  "summary": "Classification",
                  "value": {
                    "action": ["classification"],
                    "text": "Premium wireless headphones with active noise cancellation, 30-hour battery life, and crystal-clear audio quality."
                  }
                },
                "nudges": {
                  "summary": "Nudges",
                  "value": {
                    "action": ["nudges"],
                    "ruleset": "product_description",
                    "text": "This product is good and works well.",
                    "max_nudges": 3
                  }
                },
                "clean": {
                  "summary": "Clean",
                  "value": {
                    "action": ["clean"],
                    "text": "This is a sentance with speling and grammer erors that need to be fixed."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "action": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "result": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid parameters or malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Ruleset not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests - Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Server-side error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Your Whetdata API key"
      }
    }
  }
}
