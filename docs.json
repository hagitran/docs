{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Whetdata Documentation",
  "colors": {
    "primary": "#1d4ed8",
    "light": "#3B82F6",
    "dark": "#1E40AF"
  },
  "favicon": "/favicon.svg",
  "css": "./style.css",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "defaults": "required",
      "prefill": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "introduction",
              "quick-start"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "api-reference/rulesets",
              "api-reference/errors",
              "api-reference/security"
            ]
          },
          {
            "group": "Actions",
            "pages": [
              "api-reference/endpoint/classify",
              "api-reference/endpoint/nudges",
              "api-reference/endpoint/clean"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@whetdata.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://whetdata.com/dashboard",
      "style": "rounded-none"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/whetdata",
      "github": "https://github.com/whetdata",
      "linkedin": "https://linkedin.com/company/whetdata"
    }
  }
}
